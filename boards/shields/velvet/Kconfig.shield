config SHIELD_VELVET_LEFT
    def_bool $(shields_list_contains,velvet_left)

config SHIELD_VELVET_RIGHT
    def_bool $(shields_list_contains,velvet_right)

config SHIELD_VELVET_PROSPECTOR_DONGLE
    def_bool $(shields_list_contains,velvet_prospector_dongle)

config SHIELD_VELVET_PROSPECTOR_PERIPHERAL
    def_bool $(shields_list_contains,velvet_prospector_peripheral)

config ZMK_SPLIT_ROLE_CENTRAL
    default y if SHIELD_VELVET_PROSPECTOR_DONGLE

# Keyboard halves use PWM backlight; the Prospector dongle does not.
config ZMK_BACKLIGHT
    default y if SHIELD_VELVET_LEFT || (SHIELD_VELVET_RIGHT && !SHIELD_VELVET_PROSPECTOR_PERIPHERAL)

# Keep the built-in Nice!View screen for keyboard halves; Prospector selects its own screen.
config ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    default y if SHIELD_VELVET_LEFT || (SHIELD_VELVET_RIGHT && !SHIELD_VELVET_PROSPECTOR_PERIPHERAL)
